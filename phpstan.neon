includes:
    # The 9.851 errors that existed on 2026-09-17, frozen so new ones fail the run.
    # This is not a list of things that are fine: it is the debt, made visible and
    # kept from growing. Shrink it by category (see the notes in ignoreErrors) and
    # regenerate; never add to it to silence something new.
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    # - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    # Analysis level (0-9, max = 9)
    level: 9

    tmpDir: /tmp/phpstan
    
    # Directories to analyze
    paths:
        - app/
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        - Modules/
    
    # Files to exclude
    excludePaths:
        # Exclude only the main _ide_helper.php file (generated by barryvdh/laravel-ide-helper)
        - _ide_helper.php (?)
        - .phpstorm.meta.php (?)
        # Exclude vendor files that may cause issues
        - vendor/**
        - storage/*
        - bootstrap/cache/*
        # Module test suites. PHPStan cannot read Pest's DSL without
        # pestphp/pest-plugin-phpstan, which is not installed (its include is
        # commented out at the top of this file). Without it the suites reported
        # 23.067 of the 33.282 errors, 11.793 of them the single identifier
        # method.internalClass: every `expect(...)->toBe(...)` call in the project,
        # read as reaching into Pest's internals. They are artefacts of the missing
        # extension, not defects. Delete these two lines when the plugin is installed.
        - Modules/*/tests/*
        - Modules/*/tests/**
        # Two files under Modules/Core/stubs are App-side templates used only by the
        # test suite; one deliberately extends a final class, which works there because
        # BypassFinals is active and is an error to report anywhere else.
        - Modules/*/stubs/*
        - Modules/*/stubs/**
    
    # Ignore specific errors
    ignoreErrors:
        # - '#Call to an undefined method [a-zA-Z0-9\\_]+::shouldReceive\(\)#'
        # - '#Call to an undefined method Illuminate\\Routing\\Route::name\(\).$#'
        # - '#Call to an undefined method Illuminate\\Routing\\Route::withoutMiddleware\(\).$#'
        # - '#Call to an undefined method Illuminate\\Routing\\Route::can\(\).$#'
        # - '#Call to an undefined method Illuminate\\Routing\\Route::where\(\).$#'
        # - '#Call to an undefined static method Illuminate\\Database\\Eloquent\\Model::withTrashed\(\).$#'
        # - '#Call to an undefined static method Illuminate\\Database\\Eloquent\\Model::getTimestampColumns\(\).$#'
        # - '#Call to an undefined method Modules\\Core\Grids\\Casts\\GridRequestData|Modules\\Core\\Grids\\Requests\\GridRequest::getMethod\(\).$#'
        # - '#Call to an undefined method Illuminate\\Http\\Request::getMethod\(\).$#'
        # Ignore errors related to methods from the HasValidations and HasPermissions traits
        # - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::shouldSkipValidation\(\)#'
        # - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::validateWithRules\(\)#'
        # - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::getRules\(\)#'
        # - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::getOperationRules\(\)#'
        # - '#Call to an undefined method Illuminate\\Foundation\\Auth\\User::isSuperAdmin\(\)#'
        # - '#Call to an undefined method Illuminate\\Foundation\\Auth\\User::hasPermission\(\)#'
        - 
          message: "#Called 'env' outside of the config directory which returns null when the config is cached, use 'config'.$#"
          identifier: larastan.noEnvCallsOutsideOfConfig
          path: Modules/*/config/*
        # - '#Static call to instance method __construct\(\)#'
        # A column name passed as a string through a Builder or a Model typed only as
        # Illuminate's base Model: generic code (HasTable, CrudService, the importers)
        # that works on any model. The base class declares no column, so Larastan's
        # column check (checkModelProperties) reports every such name, none a defect.
        # Limited to the exact base class: a concrete model, or Model&Contract, is
        # still checked against the columns it declares.
        -
          identifier: argument.type
          message: '#model property of Illuminate\\Database\\Eloquent\\Model[,>]#'
        # A JSON path (`meta->erp_role`), Laravel's way to query inside a json column.
        # Larastan checks the whole string as a column name and reports every path.
        # Limited to strings shaped column->key, so a plain misspelled column is still
        # reported. PHPStan truncates long names in the message, hence the `…`.
        -
          identifier: argument.type
          message: '#model property of [^,]+, ''\w+-(?:>[\w>-]*|…)'' given\.$#'
        # Query scopes called on a Builder whose model type is a contract rather than
        # a concrete class. Larastan's BuilderHelper resolves $query->locked() by
        # reading `scope` . ucfirst($method) off the method tags of every class in the
        # builder's model type, so a contract declaring `@method scopeLocked(...)` is
        # enough and the 1.262 reports this rule used to hold are types now, not
        # silence. See ILockableModel, IValidatableModel, IActivatableModel and
        # ISoftDeletableModel, and the Builder<Model&Contract> annotations in HasTable.
        #
        # What is left are scopes on concrete models (ERP Party, SAO Ticket) and
        # spatie's scopeRole, reached through generic code that has no contract to
        # narrow to. Listed by name on purpose: a blanket rule on Builder would also
        # have hidden notLocked(), expiring() and withValidityFilter(), three scopes
        # that existed nowhere or were never registered and threw at runtime. All
        # three were found because these errors were visible, and fixed on 2026-09-18.
        -
          identifier: method.notFound
          message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Builder(<[^>]*>)?::(customers|suppliers|overdue|role)\(\)\.$#'
        # HasBenchmark is analysed once per command that uses it, and the ?? on the
        # Oracle branch resolves differently depending on the context. The baseline
        # cannot pin a count that moves, so the error is named here instead.
        -
          identifier: nullCoalesce.expr
          path: Modules/Core/app/Console/Concerns/HasBenchmark.php
        -
          identifier: nullCoalesce.expr
          path: Modules/Core/app/Overrides/Command.php
        # Searchable::eagerLoadForIndexing() adds `translations` to the eager load only
        # when the model uses HasTranslations (class_uses_trait() at runtime). Larastan
        # checks the relation name against every model that uses the trait, translated
        # or not, and the collection's model type cannot be narrowed from the check.
        # Named here, by relation and file, so a wrong relation name elsewhere still fails.
        -
          identifier: larastan.relationExistence
          message: '#^Relation ''translations'' is not found in Modules\\[A-Za-z]+\\Models\\[A-Za-z]+ model\.$#'
          path: Modules/Core/app/Search/Traits/Searchable.php
        # Both engines are analysed in more than one context, and this error appears in
        # some and not others. A baseline entry pins a count, and a count that moves is
        # reported as ignore.count, so these two are named here without one.
        -
          identifier: function.alreadyNarrowedType
          path: Modules/Core/app/Search/Engines/ElasticsearchEngine.php
        -
          identifier: function.alreadyNarrowedType
          path: Modules/Core/app/Search/Engines/TypesenseEngine.php
        # HasApprovals and HasVersions are also used by models that do not extend Core's
        # Model (test stubs such as HasApprovalsStubModel, a plain Eloquent model in a
        # module), which lack validateWithRules(), forceDelete(), isForceDeleting() or
        # softDeletesEnabledBySettings(). Their method_exists() guards are for those.
        # Against every class PHPStan analyses they are always true, and the count moves
        # with the analysed contexts, so the guard is named here, limited to these traits.
        -
          identifier: function.alreadyNarrowedType
          message: '#^Call to function method_exists\(\) with .+ will always evaluate to true\.$#'
          paths:
            - Modules/Core/app/Models/Concerns/HasApprovals.php
            - Modules/Core/app/Models/Concerns/HasVersions.php
        # Trigger and function DDL (CREATE TRIGGER, CREATE FUNCTION, Oracle blocks) cannot
        # go through a prepared statement, so it runs through unprepared(), and the trigger
        # names are built from the table names: a literal string is impossible. What is
        # interpolated is a table, trigger or constraint name taken from code (the module's
        # table enums), wrapped by the query grammar, never input. Limited to migrations and
        # MigrateUtils, so an unprepared() anywhere else is still reported.
        -
          identifier: argument.type
          message: '#^Parameter \#1 \$query of method Illuminate\\Database\\Connection::unprepared\(\) expects literal-string, .+ given\.$#'
          paths:
            - Modules/*/database/migrations/*
            - Modules/Core/app/Helpers/MigrateUtils.php
        # Laravel Scout - methods added by the Searchable trait
        - '#Call to an undefined method.*::searchableAs\(\)#'
        # Carried over from the module phpstan.neon files when the toolchain was centralized
        # (2026-09-15). Their paths were module-relative; they are prefixed here.
        -
            identifier: new.staticInAbstractClassStaticMethod
            path: Modules/CMS/app/Services/Contracts/AbstractGeocodingService.php
        -
            identifier: new.static
            path: Modules/CMS/app/Services/Contracts/AbstractGeocodingService.php
    # Do not report unmatched patterns (to avoid warnings on IDE helper files)
    reportUnmatchedIgnoredErrors: false

    # Laravel configuration
    # On: every model declares its columns as @property tags (plan
    # 2026-11-24-phpstan-typed-model-columns, D1; written once by Core's
    # models:declare-columns, guarded by the app test ModelsDeclareTheirColumnsTest),
    # so a column name passed as a string to where(), pluck(), forceFill(), create()
    # or update() is checked against the columns the model declares. It was off from
    # laraplate#81 until then, when the models declared none.
    checkModelProperties: true
    checkOctaneCompatibility: true
    noEnvCallsOutsideOfConfig: true
    checkModelAppends: true