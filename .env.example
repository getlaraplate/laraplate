APP_NAME="Laraplate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=127.0.0.1,::1
APP_PORT=8000
APP_LOGO="https://raw.githubusercontent.com/getlaraplate/brand/master/logos/blueprint/laraplate.svg"
APP_FAVICON="https://raw.githubusercontent.com/getlaraplate/brand/master/logos/blueprint/laraplate.svg"

# FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# APP_EDITOR=VSCode

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_DAILY_DAYS=2

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=sessions

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Per-minute rate limit for the embeddings job queue; raise for faster bulk backfills.
EMBEDDINGS_QUEUE_RATE_PER_MINUTE=10
# Optimistic batch size for bulk (scout:import) reindexing; the adaptive batcher shrinks it when the engine strains.
BULK_INDEX_BATCH=100

CACHE_STORE=redis
CACHE_PREFIX=laraplate
SCOUT_QUEUE=true
SCOUT_DRIVER=elasticsearch

HORIZON_MEMORY_LIMIT=1024

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=180

HORIZON_MEMORY_LIMIT=1024

