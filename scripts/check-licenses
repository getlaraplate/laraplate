#!/usr/bin/env bash
# check-licenses: check the licenses of a project's dependencies against the project license.
# Requires bash 4.4+ and jq. See README.md.

LCC_VERSION="2.0.0"

# Field separator of the records passed between stages (ASCII unit separator).
# Not TAB: tab is IFS whitespace, so `read` would collapse empty fields.
LCC_FS=$'\x1f'

lcc_die() {
    printf 'check-licenses: %s\n' "$*" >&2
    exit 2
}

lcc_require_env() {
    if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
        lcc_die "bash 4.4 or later is required (found ${BASH_VERSION})"
    fi
    command -v jq >/dev/null 2>&1 || lcc_die "jq is required but was not found in PATH"
}

lcc_usage() {
    cat <<'USAGE'
Usage: check-licenses [options]

Options:
  --path DIR              Project root to check (default: current directory)
  --config FILE           Config file (default: DIR/.license-compliance)
  --project-license ID    SPDX id of the project license (overrides detection)
  --json                  Print the report as JSON
  --strict                Exit 1 also when an entry needs manual review
  --version               Print the version
  --help                  Show this help

Exit codes: 0 no forbidden entry, 1 forbidden entry (or review with --strict), 2 usage error.
USAGE
}

lcc_parse_args() {
    LCC_PATH="."
    LCC_CONFIG=""
    LCC_PROJECT_LICENSE_OPT=""
    LCC_JSON=0
    LCC_STRICT=0

    while (($# > 0)); do
        case "$1" in
            --path) (($# >= 2)) || lcc_die "--path needs a value"; LCC_PATH="$2"; shift 2 ;;
            --config) (($# >= 2)) || lcc_die "--config needs a value"; LCC_CONFIG="$2"; shift 2 ;;
            --project-license) (($# >= 2)) || lcc_die "--project-license needs a value"; LCC_PROJECT_LICENSE_OPT="$2"; shift 2 ;;
            --json) LCC_JSON=1; shift ;;
            --strict) LCC_STRICT=1; shift ;;
            --version) printf 'check-licenses %s\n' "$LCC_VERSION"; exit 0 ;;
            --help|-h) lcc_usage; exit 0 ;;
            *) lcc_die "unknown option: $1 (see --help)" ;;
        esac
    done
}

# Built-in matrix. Keys of LCC_MATRIX are project licenses; values are space-separated
# patterns (exact SPDX id, "BSD-*", "GPL->=3.0") and @group references.
lcc_load_defaults() {
    LCC_PROJECT_LICENSE=""
    declare -ga LCC_EXCLUDE=(.git build dist node_modules/.cache)
    declare -ga LCC_INCLUDE=()
    declare -gA LCC_ALLOW=() LCC_GROUPS=() LCC_MATRIX=() LCC_FAMILIES=()

    LCC_FAMILIES=(
        [GPL-2.0-only]="GPL 2.0" [GPL-2.0-or-later]="GPL 2.0"
        [GPL-3.0-only]="GPL 3.0" [GPL-3.0-or-later]="GPL 3.0"
        [AGPL-3.0-or-later]="AGPL 3.0"
        [Apache-1.0]="Apache 1.0" [Apache-1.1]="Apache 1.1" [Apache-2.0]="Apache 2.0"
    )

    LCC_GROUPS[permissive]="0BSD Apache-* BSD-* CC0-* CC-BY-* CC-BY-NC-* CC-BY-NC-SA-* CC-BY-SA-* GPL-* AGPL-* ISC LGPL-* MIT MPL-2.0 WTFPL Unlicense Zlib"
    LCC_GROUPS[permissive-no-strong-copyleft]="0BSD Apache-* BSD-* CC0-* CC-BY-* CC-BY-NC-* CC-BY-NC-SA-* ISC LGPL-* MIT MPL-2.0 WTFPL Unlicense Zlib"
    # a GPL-3.0 or AGPL-3.0 project: GPL-2.0-only is not compatible, GPL-2.0-or-later and GPL/AGPL 3 are
    LCC_GROUPS[gpl3-compatible]="0BSD Apache-* BSD-* CC0-* CC-BY-* CC-BY-NC-* CC-BY-NC-SA-* CC-BY-SA-* GPL->=3.0 GPL-2.0-or-later AGPL-* ISC LGPL-* MIT MPL-2.0 WTFPL Unlicense Zlib"
    LCC_GROUPS[proprietary-allowed]="0BSD Apache-* BSD-* CC0-1.0 CC-BY-* ISC LGPL-* MIT MPL-2.0 WTFPL Unlicense Zlib"

    local id
    for id in proprietary UNLICENSED; do
        LCC_MATRIX[$id]="@proprietary-allowed"
    done
    for id in MIT Apache-1.0 Apache-1.1 Apache-2.0 BSD-2-Clause BSD-3-Clause BSD-4-Clause \
        GPL-2.0-or-later \
        CC0-1.0 CC-BY-3.0 CC-BY-4.0 CC-BY-SA-3.0 CC-BY-SA-4.0; do
        LCC_MATRIX[$id]="@permissive"
    done
    for id in GPL-3.0-only GPL-3.0-or-later AGPL-3.0-or-later; do
        LCC_MATRIX[$id]="@gpl3-compatible"
    done
    for id in CC-BY-NC-3.0 CC-BY-NC-4.0 CC-BY-NC-SA-3.0 CC-BY-NC-SA-4.0; do
        LCC_MATRIX[$id]="@permissive-no-strong-copyleft"
    done
    LCC_MATRIX[GPL-2.0-only]="0BSD Apache-* BSD-* CC0-* CC-BY-* CC-BY-NC-* CC-BY-NC-SA-* CC-BY-SA-* GPL-<=2.0 ISC LGPL-* MIT MPL-2.0 WTFPL"
}

# Read a project config file (one directive per line, "#" starts a comment).
lcc_load_config() {
    local file="$1" line n=0 directive rest name values
    [[ -r "$file" ]] || lcc_die "cannot read config: $file"

    while IFS= read -r line || [[ -n "$line" ]]; do
        n=$((n + 1))
        line="${line%%#*}"
        directive="" rest=""
        read -r directive rest <<<"$line" || true
        [[ -n "$directive" ]] || continue
        [[ -n "$rest" ]] || lcc_die "$file:$n: directive '$directive' needs a value"

        case "$directive" in
            project-license) LCC_PROJECT_LICENSE="$rest" ;;
            exclude) LCC_EXCLUDE+=("$rest") ;;
            include) LCC_INCLUDE+=("$rest") ;;
            allow | group | matrix)
                read -r name values <<<"$rest"
                [[ -n "$values" ]] || lcc_die "$file:$n: '$directive $name' needs at least one value"
                case "$directive" in
                    allow) LCC_ALLOW[$name]="$values" ;;
                    group) LCC_GROUPS[$name]="$values" ;;
                    matrix) LCC_MATRIX[$name]="$values" ;;
                esac
                ;;
            *) lcc_die "$file:$n: unknown directive '$directive'" ;;
        esac
    done <"$file"
}

# Print the flat, unique list of patterns of the arguments, one per line.
# "@name" arguments expand to the group's patterns (recursively; cycles are cut).
lcc_expand_patterns() {
    local -A _seen_groups=() _seen_out=()
    lcc__expand "$@"
}

lcc__expand() {
    local p name
    local -a sub
    for p in "$@"; do
        [[ -n "$p" ]] || continue
        if [[ "$p" == @* ]]; then
            name="${p:1}"
            [[ -z "${_seen_groups[$name]:-}" ]] || continue
            _seen_groups[$name]=1
            [[ -n "${LCC_GROUPS[$name]+x}" ]] || continue
            read -ra sub <<<"${LCC_GROUPS[$name]}"
            lcc__expand "${sub[@]}"
        else
            [[ -z "${_seen_out[$p]:-}" ]] || continue
            _seen_out[$p]=1
            printf '%s\n' "$p"
        fi
    done
}

# True when version $1 is >= version $2.
lcc__version_ge() {
    [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n 1)" == "$2" ]]
}

# lcc_license_matches LICENSE PATTERN... : exit 0 when LICENSE matches any pattern.
lcc_license_matches() {
    local license="$1" pattern prefix family op constraint fam lic_family lic_version
    local re='^([A-Za-z0-9.-]+)-(>=|<=|>|<)([0-9.]+)$'
    shift
    license="${license#"${license%%[![:space:]]*}"}"
    license="${license%"${license##*[![:space:]]}"}"
    # a compound expression (spaces) is never a single license id: patterns must not match it whole
    [[ "$license" != *[[:space:]]* ]] || return 1

    for pattern in "$@"; do
        if [[ "$pattern" == *-\* ]]; then
            prefix="${pattern%\*}"
            [[ "$license" == "$prefix"* ]] && return 0
            continue
        fi

        if [[ "$pattern" =~ $re ]]; then
            family="${BASH_REMATCH[1]}" op="${BASH_REMATCH[2]}" constraint="${BASH_REMATCH[3]}"
            fam="${LCC_FAMILIES[$license]:-}"
            [[ -n "$fam" ]] || continue
            read -r lic_family lic_version <<<"$fam"
            [[ "$lic_family" == "$family" ]] || continue
            case "$op" in
                '>=') lcc__version_ge "$lic_version" "$constraint" && return 0 ;;
                '<=') lcc__version_ge "$constraint" "$lic_version" && return 0 ;;
                '>') lcc__version_ge "$lic_version" "$constraint" && ! lcc__version_ge "$constraint" "$lic_version" && return 0 ;;
                '<') lcc__version_ge "$constraint" "$lic_version" && ! lcc__version_ge "$lic_version" "$constraint" && return 0 ;;
            esac
            continue
        fi

        [[ "$license" == "$pattern" ]] && return 0
    done
    return 1
}

# lcc_is_allowed EXPRESSION PATTERN... : exit 0 when the SPDX expression is allowed.
lcc_is_allowed() {
    local expr="$1" part
    shift
    expr="${expr#"${expr%%[![:space:]]*}"}"
    expr="${expr%"${expr##*[![:space:]]}"}"
    [[ -n "$expr" && "$expr" != "UNKNOWN" ]] || return 1

    # One pair of outer parentheses is dropped; anything nested cannot be evaluated (exit 2).
    if [[ "$expr" == \(*\) && "${expr:1:${#expr}-2}" != *[\(\)]* ]]; then
        expr="${expr:1:${#expr}-2}"
        expr="${expr#"${expr%%[![:space:]]*}"}"
        expr="${expr%"${expr##*[![:space:]]}"}"
    fi
    [[ "$expr" != *[\(\)]* ]] || return 2

    lcc_license_matches "$expr" "$@" && return 0

    # AND binds tighter than OR: the expression is allowed when one OR branch has all its AND parts allowed.
    local branch ok
    while IFS= read -r branch; do
        ok=1
        while IFS= read -r part; do
            lcc_license_matches "$part" "$@" || { ok=0; break; }
        done <<<"${branch// AND /$'\n'}"
        ((ok)) && return 0
    done <<<"${expr// OR /$'\n'}"
    return 1
}

# lcc_patterns_for PROJECT_LICENSE : print the expanded patterns allowed for that license.
lcc_patterns_for() {
    local -a raw
    [[ -n "${LCC_MATRIX[$1]+x}" ]] || return 1
    read -ra raw <<<"${LCC_MATRIX[$1]}"
    lcc_expand_patterns "${raw[@]}"
}

# lcc__clean_to VAR VALUE : set VAR to VALUE made safe to be a record field (no fork).
lcc__clean_to() {
    local _s="$2"
    _s="${_s//$'\t'/ }"
    _s="${_s//$'\n'/ }"
    _s="${_s//$LCC_FS/ }"
    printf -v "$1" '%s' "$_s"
}

# lcc__read_head FILE : set REPLY to the head (16 KB) of a text file, lower-cased with whitespace squeezed.
# Fails for empty and binary files (a NUL byte inside the head). No fork.
lcc__read_head() {
    local LC_ALL=C t="" rc=0 # bytes, not characters: texts may hold multibyte characters (the (c) sign)
    IFS= read -r -d '' -n 16384 t 2>/dev/null <"$1" || rc=$?
    [[ -n "$t" ]] || return 1
    # read stops at a NUL byte before 16384 characters with status 0; at the end of a text file it returns 1
    if ((rc == 0 && ${#t} < 16384)); then return 1; fi
    t="${t,,}"
    t="${t//[$'\t\r\n']/ }"
    while [[ "$t" == *"  "* ]]; do t="${t//  / }"; done
    REPLY="$t"
}

# lcc__detect_text FILE : set REPLY to the SPDX id recognised in a license text; fail when unknown.
lcc__detect_text() {
    local t g suffix id="" best="" bestpos=99999 pos pre title
    lcc__read_head "$1" || return 1
    t="$REPLY"

    # The GNU licenses are recognized by the title or notice at the top of the text, the family being the
    # title that comes first (the GPL-2 preamble mentions the LGPL, the LGPL-3 text quotes the GPL, and MPL-2.0
    # names three GNU licenses as secondary licenses further down).
    g="${t:0:800}"
    suffix="-only"
    [[ "$g" == *"any later version"* ]] && suffix="-or-later"
    for title in "gnu affero general public license" "gnu lesser general public license" "gnu library general public license" "gnu general public license"; do
        pre="${g%%"$title"*}"
        [[ "$pre" != "$g" ]] || continue
        pos=${#pre}
        if ((pos < bestpos)); then bestpos=$pos best="$title"; fi
    done

    if [[ "$t" == *"mozilla public license"* && "$t" == *"version 2.0"* ]]; then
        id="MPL-2.0"
    elif [[ "$t" == *"apache license"* && "$t" == *"version 2.0"* ]]; then
        id="Apache-2.0"
    elif [[ -n "$best" ]]; then
        case "$best" in
            *affero*) id="AGPL-3.0${suffix}" ;;
            *lesser* | *library*)
                if [[ "$g" == *"version 2.1"* ]]; then
                    id="LGPL-2.1${suffix}"
                elif [[ "$g" == *"version 3"* ]]; then
                    id="LGPL-3.0${suffix}"
                else
                    id="LGPL-2.0${suffix}"
                fi
                ;;
            *)
                if [[ "$g" == *"version 3"* ]]; then
                    id="GPL-3.0${suffix}"
                elif [[ "$g" == *"version 2"* ]]; then
                    id="GPL-2.0${suffix}"
                fi
                ;;
        esac
    elif [[ "$t" == *"cc0 1.0 universal"* ]]; then
        id="CC0-1.0"
    elif [[ "$t" == *"free and unencumbered software released into the public domain"* ]]; then
        id="Unlicense"
    elif [[ "$t" == *"sil open font license"* ]]; then
        if [[ "$t" == *"version 1.1"* ]]; then id="OFL-1.1"; else id="OFL-1.0"; fi
    elif [[ "$t" == *"the origin of this software must not be misrepresented"* ]]; then
        id="Zlib"
    elif [[ "$t" == *"boost software license"* ]]; then
        id="BSL-1.0"
    elif [[ "$t" == *"the php license"* ]]; then
        if [[ "$t" == *"version 3.01"* ]]; then id="PHP-3.01"; else id="PHP-3.0"; fi
    elif [[ "$t" == *"zope public license"* ]]; then
        if [[ "$t" == *"version 2.1"* ]]; then id="ZPL-2.1"; else id="ZPL-2.0"; fi
    elif [[ "$t" == *"permission is hereby granted, free of charge"* ]]; then
        id="MIT"
    elif [[ "$t" == *"permission to use, copy, modify, and/or distribute this software for any purpose with or without fee is hereby granted"* ]]; then
        if [[ "$t" == *"provided that the above copyright notice"* ]]; then
            id="ISC"
        else
            id="0BSD"
        fi
    elif [[ "$t" == *"redistribution and use in source and binary forms"* ]]; then
        if [[ "$t" == *"all advertising materials mentioning"* ]]; then
            id="BSD-4-Clause"
        elif [[ "$t" == *"neither the name of"* ]]; then
            id="BSD-3-Clause"
        else
            id="BSD-2-Clause"
        fi
    fi

    [[ -n "$id" ]] || return 1
    REPLY="$id"
}

# lcc_detect_text FILE : print the SPDX id recognised in a license text; exit 1 when unknown.
lcc_detect_text() {
    lcc__detect_text "$1" || return 1
    printf '%s\n' "$REPLY"
}

# lcc__license_from_filename PATH : LICENSES/<id>.txt (REUSE layout) sets REPLY to <id>.
lcc__license_from_filename() {
    local path="$1" base dir
    base="${path##*/}"
    dir="${path%/*}"
    dir="${dir##*/}"
    [[ "$dir" == "LICENSES" ]] || return 1
    base="${base%.txt}"
    base="${base%.md}"
    [[ "$base" =~ ^[A-Za-z0-9][A-Za-z0-9.+-]*$ ]] || return 1
    case "${base,,}" in readme | readme.* | index | changelog) return 1 ;; esac
    REPLY="$base"
}

lcc_license_from_filename() {
    lcc__license_from_filename "$1" || return 1
    printf '%s\n' "$REPLY"
}

# lcc__spdx_header FILE : set REPLY to the SPDX-License-Identifier expression found in the first 30 lines.
lcc__spdx_header() {
    local -a lines=()
    local line expr
    local re='^[(]*[A-Za-z0-9.+-]+([)]* (AND|OR|WITH) [(]*[A-Za-z0-9.+-]+)*[)]*$'
    mapfile -n 30 -t lines 2>/dev/null <"$1" || return 1
    for line in "${lines[@]}"; do
        [[ "$line" == *"SPDX-License-Identifier:"* ]] || continue
        expr="${line#*SPDX-License-Identifier:}"
        expr="${expr%%\*/*}"
        expr="${expr%%-->*}"
        expr="${expr%%#\}*}"
        expr="${expr%%\}\}*}"
        expr="${expr#"${expr%%[![:space:]]*}"}"
        expr="${expr%"${expr##*[![:space:]]}"}"
        # ids joined by AND / OR / WITH: anything else is prose that merely quotes the tag
        [[ "$expr" =~ $re ]] || return 1
        REPLY="$expr"
        return 0
    done
    return 1
}

lcc_detect_spdx_header() {
    lcc__spdx_header "$1" || return 1
    printf '%s\n' "$REPLY"
}

# Exclusions in effect: LCC_EXCLUDE minus LCC_INCLUDE, one per line.
lcc__effective_excludes() {
    local e inc=" ${LCC_INCLUDE[*]:-} "
    for e in "${LCC_EXCLUDE[@]}"; do
        [[ "$inc" == *" $e "* ]] || printf '%s\n' "$e"
    done
}

# True when a base name looks like a license file (and not like source code).
lcc__is_license_name() {
    local n="${1,,}"
    local re='^(licen[cs]e|copying|unlicense|notice)([-._ ][a-z0-9._+ -]*)?$'
    case "$n" in
        *readme* | *.js | *.mjs | *.cjs | *.ts | *.json | *.py | *.pyc | *.php | *.rb | *.java | *.go | *.rs | *.c | *.h | *.cc | *.cpp | *.hpp | *.sh | *.yml | *.yaml | *.xml | *.toml | *.lock | *.map | *.css)
            return 1
            ;;
    esac
    [[ "$n" =~ $re ]]
}

# Print (NUL-separated) the candidate license files under ROOT.
lcc__find_license_files() {
    lcc__find "$1" \( -type f -o -type l \) \
        \( -iname 'licen[cs]e*' -o -iname 'copying*' -o -iname 'unlicense*' -o -iname 'notice*' -o -path '*/LICENSES/*' \)
}

# lcc__find ROOT PREDICATE... : print (NUL-separated) what matches the predicates under ROOT,
# skipping the effective exclusions. Symlinked directories are not followed.
lcc__find() {
    local root="$1" e sep=0
    shift
    local -a prune=()
    while IFS= read -r e; do
        ((sep)) && prune+=(-o)
        if [[ "$e" == */* ]]; then
            prune+=(\( -path "$root/$e" -o -path "*/$e" \))
        else
            prune+=(-name "$e")
        fi
        sep=1
    done < <(lcc__effective_excludes)

    if ((${#prune[@]})); then
        find -P "$root" -mindepth 1 -type d \( "${prune[@]}" \) -prune -o \( "$@" \) -print0
    else
        find -P "$root" -mindepth 1 \( "$@" \) -print0
    fi
}

# lcc__discover_files ROOT : one record per directory with license files, per submodule and per SPDX header
#   name FS version FS path FS license FS source FS note     (source: file, header, submodule)
lcc__discover_files() {
    local root file rel dir d base f id e sp key expr hit n rest
    root="$(cd -- "$1" && pwd -P)" || return 1

    local -A dirfiles=() subs=() hdr=()
    local -a out=() main=() notices=() ids=() unknown=() slash_excludes=()

    # 1. license files, grouped by directory
    while IFS= read -r -d '' file; do
        [[ -f "$file" ]] || continue
        rel="${file#"$root"/}"
        [[ "$rel" != *$'\n'* && "$rel" != *"$LCC_FS"* ]] || continue
        d="${file%/*}"
        base="${file##*/}"
        if [[ "${d##*/}" != "LICENSES" ]]; then
            lcc__is_license_name "$base" || continue
        fi
        dir="${rel%/*}"
        [[ "$rel" == */* ]] || dir="."
        if [[ "$dir" == "LICENSES" ]]; then
            dir="."
        elif [[ "$dir" == */LICENSES ]]; then
            dir="${dir%/LICENSES}"
        fi
        dirfiles[$dir]+="${rel}${LCC_FS}"
    done < <(lcc__find_license_files "$root")

    # 2. submodules declared in .gitmodules
    if [[ -r "$root/.gitmodules" ]]; then
        while IFS= read -r sp; do
            [[ -n "$sp" ]] || continue
            subs[${sp%/}]=1
        done < <(sed -n -E 's/^[[:space:]]*path[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*$/\1/p' "$root/.gitmodules")
    fi

    # 3. one record per directory with license files
    local source license note name path
    local -a _f=()
    for dir in "${!dirfiles[@]}"; do
        [[ "$dir" != "." ]] || continue
        IFS=$LCC_FS read -ra _f <<<"${dirfiles[$dir]}"
        if ((${#_f[@]} > 1)); then
            mapfile -t main < <(printf '%s\n' "${_f[@]}" | LC_ALL=C sort)
        else
            main=("${_f[@]}")
        fi
        notices=()
        local -a keep=()
        for f in "${main[@]}"; do
            d="${f%/*}"
            if [[ "${f##*/}" == [Nn][Oo][Tt][Ii][Cc][Ee]* && "${d##*/}" != "LICENSES" ]]; then
                notices+=("$f")
            else
                keep+=("$f")
            fi
        done
        if ((${#keep[@]})); then main=("${keep[@]}"); else main=("${notices[@]}"); fi
        unset keep

        ids=()
        unknown=()
        for f in "${main[@]}"; do
            if lcc__license_from_filename "$root/$f" || lcc__detect_text "$root/$f"; then
                ids+=("$REPLY")
            else
                unknown+=("${f##*/}")
            fi
        done

        license="" note=""
        if ((${#ids[@]})); then
            if ((${#ids[@]} > 1)); then
                mapfile -t ids < <(printf '%s\n' "${ids[@]}" | LC_ALL=C sort -u)
            fi
            license="${ids[0]}"
            for ((n = 1; n < ${#ids[@]}; n++)); do license+=" AND ${ids[n]}"; done
            ((${#ids[@]} > 1)) && note="multiple license files"
            if ((${#unknown[@]})); then
                [[ -z "$note" ]] || note+="; "
                note+="unrecognized: ${unknown[*]}"
            fi
        else
            note="license text not recognized"
        fi

        source="file"
        [[ -z "${subs[$dir]:-}" ]] || source="submodule"
        lcc__clean_to name "$dir"
        lcc__clean_to path "${main[0]}"
        out+=("${name}${LCC_FS}${LCC_FS}${path}${LCC_FS}${license}${LCC_FS}${source}${LCC_FS}${note}")
    done

    # 4. submodules without license files (or not checked out)
    for sp in "${!subs[@]}"; do
        [[ -z "${dirfiles[$sp]:-}" ]] || continue
        lcc__clean_to name "$sp"
        out+=("${name}${LCC_FS}${LCC_FS}${name}${LCC_FS}${LCC_FS}submodule${LCC_FS}no license file found (submodule may not be checked out)")
    done

    # 5. SPDX headers in the first 30 lines of any text file: one record per directory and expression
    local -a grep_args=(-rIn --null -m 1)
    while IFS= read -r e; do
        if [[ "$e" == */* ]]; then slash_excludes+=("$e"); else grep_args+=("--exclude-dir=$e"); fi
    done < <(lcc__effective_excludes)

    while IFS= read -r -d '' file && IFS= read -r rest; do
        n="${rest%%:*}"
        [[ "$n" =~ ^[0-9]+$ ]] || continue
        ((n <= 30)) || continue
        rel="${file#"$root"/}"
        [[ "$rel" != *$'\n'* && "$rel" != *"$LCC_FS"* && "$rel" == */* ]] || continue
        hit=0
        for e in ${slash_excludes[@]+"${slash_excludes[@]}"}; do
            [[ "/$rel" == *"/$e/"* ]] && hit=1
        done
        ((hit == 0)) || continue
        lcc__spdx_header "$file" || continue
        expr="$REPLY"
        dir="${rel%/*}"
        key="${dir}${LCC_FS}${expr}"
        if [[ -z "${hdr[$key]:-}" || "$rel" < "${hdr[$key]}" ]]; then hdr[$key]="$rel"; fi
    done < <(grep "${grep_args[@]}" 'SPDX-License-Identifier:' "$root" 2>/dev/null)

    local hp hl
    for key in "${!hdr[@]}"; do
        dir="${key%%"$LCC_FS"*}"
        expr="${key#*"$LCC_FS"}"
        lcc__clean_to name "$dir"
        lcc__clean_to hp "${hdr[$key]}"
        lcc__clean_to hl "$expr"
        out+=("${name}${LCC_FS}${LCC_FS}${hp}${LCC_FS}${hl}${LCC_FS}header${LCC_FS}")
    done

    ((${#out[@]})) || return 0
    printf '%s\n' "${out[@]}" | LC_ALL=C sort
}

# Common jq tail: sanitize the fields and join them into a record.
# shellcheck disable=SC2016  # jq code, not shell: $fs is a jq variable
LCC_JQ_RECORD='map(tostring | gsub("[\t\n\u001f]"; " ")) | join($fs)'

# lcc_read_package_json FILE... : one manifest record per package.json (one jq run for all files).
lcc_read_package_json() {
    (($# > 0)) || return 0
    local out f prog
    prog="$(lcc__package_program)"
    # jq stops at the first unparsable file, so a failed batch is redone file by file.
    if out="$(printf '%s\0' "$@" | xargs -0 -r jq -r --arg fs "$LCC_FS" "$prog" 2>/dev/null)"; then
        [[ -z "$out" ]] || printf '%s\n' "$out"
    else
        for f in "$@"; do jq -r --arg fs "$LCC_FS" "$prog" "$f" 2>/dev/null || true; done
    fi
}

# lcc__package_program : the jq program behind lcc_read_package_json.
lcc__package_program() {
    printf '%s' '
        def lic:
            if (.license | type) == "string" then .license
            elif (.license | type) == "object" then (.license.type // "")
            elif (.licenses | type) == "array" then
                ([.licenses[] | if type == "string" then . else (.type // "") end] | map(select(. != "")) | join(" OR "))
            else "" end;
        select(.name | type == "string" and length > 0)
        | [ .name,
          (.version // ""),
          input_filename,
          (lic | gsub("^\\((?<x>.*)\\)$"; .x) | if test("^SEE LICENSE IN"; "i") then "" else . end),
          "manifest",
          "" ]
        | '"$LCC_JQ_RECORD"
}

# lcc_read_composer_lock FILE : one manifest record per locked package (packages and packages-dev).
lcc_read_composer_lock() {
    jq -r --arg fs "$LCC_FS" --arg path "$1" '
        ((.packages // []) + (."packages-dev" // []))[]
        | [ .name, (.version // ""), $path,
            ((.license // []) | if type == "array" then join(" OR ") else . end),
            "manifest", "" ]
        | '"$LCC_JQ_RECORD" "$1" 2>/dev/null || true
}

# Map a free-text license name (pom.xml) to an SPDX id when it is a well-known one.
lcc__map_license_name() {
    local n="${1,,}"
    case "$n" in
        *apache*2.0* | *apache*"version 2") printf 'Apache-2.0\n' ;;
        *"mit license"* | "the mit"* | mit) printf 'MIT\n' ;;
        *bsd*3*clause* | *"new bsd"* | *"revised bsd"*) printf 'BSD-3-Clause\n' ;;
        *bsd*2*clause* | *"simplified bsd"*) printf 'BSD-2-Clause\n' ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# lcc_read_flat_manifest FILE : manifest record from Cargo.toml, pyproject.toml or pom.xml (license field only).
lcc_read_flat_manifest() {
    local file="$1" name="" version="" license=""
    case "${file##*/}" in
        Cargo.toml | pyproject.toml)
            name="$(sed -n -E 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' "$file" | head -n 1)"
            version="$(sed -n -E 's/^[[:space:]]*version[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' "$file" | head -n 1)"
            license="$(sed -n -E \
                -e 's/^[[:space:]]*license[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' \
                -e 's/^[[:space:]]*license[[:space:]]*=[[:space:]]*\{[^}]*text[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' \
                "$file" | head -n 1)"
            ;;
        pom.xml)
            if grep -q '<licenses>' "$file"; then
                license="$(tr '\n' ' ' <"$file" | sed -E 's/.*<licenses>//; s/<\/license>.*//; s/.*<name>//; s/<\/name>.*//; s/^[[:space:]]+//; s/[[:space:]]+$//')"
                [[ -z "$license" ]] || license="$(lcc__map_license_name "$license")"
            fi
            ;;
        *) return 0 ;;
    esac
    [[ -n "$name" ]] || name="${file%/*}"
    [[ "$license" != \(*\) ]] || license="${license:1:${#license}-2}"
    local c_name c_version c_file c_license
    lcc__clean_to c_name "$name"
    lcc__clean_to c_version "$version"
    lcc__clean_to c_file "$file"
    lcc__clean_to c_license "$license"
    printf '%s%s%s%s%s%s%s%s%s%s\n' \
        "$c_name" "$LCC_FS" "$c_version" "$LCC_FS" "$c_file" "$LCC_FS" "$c_license" "$LCC_FS" "manifest" "$LCC_FS"
}

# lcc__discover_manifests ROOT : manifest records of every package manifest below ROOT.
# Root-level package.json, Cargo.toml, pyproject.toml and pom.xml are the project itself and are skipped.
lcc__discover_manifests() {
    local root="$1" file rel c f
    local -a pj=() composers=() flat=()
    while IFS= read -r -d '' file; do
        rel="${file#"$root"/}"
        [[ "$rel" != *$'\n'* && "$rel" != *"$LCC_FS"* ]] || continue
        case "${rel##*/}" in
            package.json) [[ "$rel" != */* ]] || pj+=("$rel") ;;
            composer.lock) composers+=("$rel") ;;
            *) [[ "$rel" != */* ]] || flat+=("$rel") ;;
        esac
    done < <(lcc__find "$root" -type f \( -name package.json -o -name composer.lock -o -name Cargo.toml -o -name pyproject.toml -o -name pom.xml \))

    cd -- "$root" || return 1
    if ((${#pj[@]})); then lcc_read_package_json "${pj[@]}"; fi
    for c in ${composers[@]+"${composers[@]}"}; do lcc_read_composer_lock "$c"; done
    for f in ${flat[@]+"${flat[@]}"}; do lcc_read_flat_manifest "$f"; done
}

# lcc_record_key NAME PATH SOURCE : set REPLY to the directory-like key under which the sources of one package merge.
lcc_record_key() {
    local name="$1" path="$2" source="$3" d
    if [[ "$source" == "manifest" ]]; then
        if [[ "${path##*/}" == "composer.lock" ]]; then
            if [[ "$path" == */* ]]; then REPLY="${path%/*}/vendor/${name}"; else REPLY="vendor/${name}"; fi
        else
            d="${path%/*}"
            [[ "$path" == */* ]] || d="."
            REPLY="$d"
        fi
    else
        REPLY="$name"
    fi
}

# Order- and case-insensitive form of a license expression, for comparing two declarations.
lcc__norm_license() {
    local s="${1,,}"
    local -a t
    s="${s//[()]/ }"
    read -ra t <<<"$s"
    printf '%s\n' "${t[@]}" | LC_ALL=C sort | tr '\n' ' '
}

# True when two license expressions say the same thing (cheap string test first).
lcc__same_license() {
    [[ "$1" != "$2" ]] || return 0
    [[ "$(lcc__norm_license "$1")" == "$(lcc__norm_license "$2")" ]]
}

# lcc_merge_records : read records on stdin, write them with manifest/file/submodule sources of the
# same package merged. Disagreeing licenses keep the declared one plus a note. Header records pass
# through, except those that repeat the license of the package record that covers their directory.
lcc_merge_records() {
    local -A k_name=() k_ver=() k_mpath=() k_fpath=() k_mlic=() k_flic=() k_msrc=() k_fsrc=() k_note=() k_fnote=() k_seen=() k_out=()
    local -a order=() pass=()
    local name ver path lic src note key
    while IFS=$LCC_FS read -r name ver path lic src note; do
        [[ -n "$name$path" ]] || continue
        if [[ "$src" == "header" ]]; then
            pass+=("${name}${LCC_FS}${ver}${LCC_FS}${path}${LCC_FS}${lic}${LCC_FS}${src}${LCC_FS}${note}")
            continue
        fi
        lcc_record_key "$name" "$path" "$src"
        key="$REPLY"
        if [[ -z "${k_seen[$key]:-}" ]]; then
            k_seen[$key]=1
            order+=("$key")
        fi
        if [[ "$src" == "manifest" ]]; then
            k_name[$key]="$name" k_ver[$key]="$ver" k_mpath[$key]="$path" k_mlic[$key]="$lic" k_msrc[$key]=1
            [[ -z "$note" ]] || k_note[$key]+="${k_note[$key]:+; }${note}"
        else
            k_fpath[$key]="$path" k_flic[$key]="$lic" k_fsrc[$key]="$src"
            [[ -n "${k_name[$key]:-}" ]] || k_name[$key]="$name"
            k_fnote[$key]="$note"
        fi
    done

    local mlic flic fnote srcs out_lic out_note
    for key in ${order[@]+"${order[@]}"}; do
        mlic="${k_mlic[$key]:-}" flic="${k_flic[$key]:-}" fnote="${k_fnote[$key]:-}" out_note="${k_note[$key]:-}"
        srcs=""
        [[ -z "${k_msrc[$key]:-}" ]] || srcs="manifest"
        [[ -z "${k_fsrc[$key]:-}" ]] || srcs+="${srcs:++}${k_fsrc[$key]}"

        if [[ -n "$mlic" && -n "$flic" ]]; then
            out_lic="$mlic"
            if ! lcc__same_license "$mlic" "$flic"; then
                out_note+="${out_note:+; }declared ${mlic}, text says ${flic}"
            fi
        elif [[ -n "$mlic" ]]; then
            out_lic="$mlic"
            [[ "$fnote" != "license text not recognized" ]] || fnote=""
        else
            out_lic="$flic"
        fi
        [[ -z "$fnote" ]] || out_note+="${out_note:+; }${fnote}"
        k_out[$key]="$out_lic"

        printf '%s%s%s%s%s%s%s%s%s%s%s\n' \
            "${k_name[$key]}" "$LCC_FS" "${k_ver[$key]:-}" "$LCC_FS" "${k_fpath[$key]:-${k_mpath[$key]:-}}" "$LCC_FS" \
            "$out_lic" "$LCC_FS" "$srcs" "$LCC_FS" "$out_note"
    done

    local rec d keep
    for rec in ${pass[@]+"${pass[@]}"}; do
        IFS=$LCC_FS read -r name ver path lic src note <<<"$rec"
        keep=1
        d="$name"
        while :; do
            if [[ -n "${k_out[$d]+x}" ]]; then
                # nearest covering package record: a header repeating its license adds nothing
                if [[ -n "${k_out[$d]}" ]] && lcc__same_license "${k_out[$d]}" "$lic"; then keep=0; fi
                break
            fi
            [[ "$d" == */* ]] || break
            d="${d%/*}"
        done
        if ((keep)); then printf '%s\n' "$rec"; fi
    done
}

# lcc_discover ROOT : print the merged, sorted records of everything found below ROOT.
lcc_discover() {
    local root
    root="$(cd -- "$1" && pwd -P)" || return 1
    {
        lcc__discover_files "$root"
        (lcc__discover_manifests "$root")
    } | lcc_merge_records | LC_ALL=C sort
}

# lcc_detect_project_license ROOT : print the project license; exit 1 when it cannot be told.
# Order: --project-license, config, package.json / composer.json, root LICENSE file, LICENSES/ directory.
lcc_detect_project_license() {
    local root="$1" lic f id n
    local -a ids=()

    if [[ -n "${LCC_PROJECT_LICENSE_OPT:-}" ]]; then
        printf '%s\n' "$LCC_PROJECT_LICENSE_OPT"
        return 0
    fi
    if [[ -n "${LCC_PROJECT_LICENSE:-}" ]]; then
        printf '%s\n' "$LCC_PROJECT_LICENSE"
        return 0
    fi

    if [[ -r "$root/package.json" ]]; then
        lic="$(jq -r 'if (.license | type) == "string" then .license elif (.license | type) == "object" then (.license.type // "") else "" end' "$root/package.json" 2>/dev/null)" || lic=""
        if [[ -n "$lic" && "$lic" != SEE* ]]; then
            printf '%s\n' "$lic"
            return 0
        fi
    fi
    if [[ -r "$root/composer.json" ]]; then
        lic="$(jq -r 'if (.license | type) == "string" then .license elif (.license | type) == "array" and (.license | length) == 1 then .license[0] else "" end' "$root/composer.json" 2>/dev/null)" || lic=""
        if [[ -n "$lic" ]]; then
            printf '%s\n' "$lic"
            return 0
        fi
    fi

    for f in "$root"/*; do
        [[ -f "$f" ]] || continue
        lcc__is_license_name "${f##*/}" || continue
        [[ "${f##*/}" != [Nn][Oo][Tt][Ii][Cc][Ee]* ]] || continue
        if id="$(lcc_detect_text "$f")"; then
            printf '%s\n' "$id"
            return 0
        fi
    done

    if [[ -d "$root/LICENSES" ]]; then
        for f in "$root"/LICENSES/*; do
            [[ -f "$f" ]] || continue
            if id="$(lcc_license_from_filename "$f")"; then ids+=("$id"); fi
        done
        if ((${#ids[@]})); then
            mapfile -t ids < <(printf '%s\n' "${ids[@]}" | LC_ALL=C sort -u)
            lic="${ids[0]}"
            for ((n = 1; n < ${#ids[@]}; n++)); do lic+=" AND ${ids[n]}"; done
            printf '%s\n' "$lic"
            return 0
        fi
    fi
    return 1
}

# lcc_resolve_project_license ROOT : like lcc_detect_project_license, but exits 2 with a message when undetectable.
lcc_resolve_project_license() {
    lcc_detect_project_license "$1" ||
        lcc_die "Could not detect the project license. Set --project-license, 'project-license' in .license-compliance, 'license' in package.json or composer.json, or add a standard LICENSE file or a LICENSES/ directory."
}

# True when every license id of an expression is in LCC_KNOWN_PATTERNS (or is a matrix/family key).
lcc__all_known() {
    local tok
    local -a toks
    local s="${1//[()]/ }"
    s="${s// AND / }"
    s="${s// OR / }"
    read -ra toks <<<"$s"
    for tok in ${toks[@]+"${toks[@]}"}; do
        [[ -n "${LCC_MATRIX[$tok]+x}" || -n "${LCC_FAMILIES[$tok]+x}" ]] && continue
        lcc_license_matches "$tok" "${LCC_KNOWN_PATTERNS[@]}" || return 1
    done
    return 0
}

# True when the dependency has an allow line covering every license id of the expression.
lcc__allow_exception() {
    local name="$1" lic="$2" tok list
    local -a toks
    [[ -n "${LCC_ALLOW[$name]+x}" ]] || return 1
    list=" ${LCC_ALLOW[$name]} "
    [[ "$list" != *" * "* ]] || return 0
    local s="${lic//[()]/ }"
    s="${s// AND / }"
    s="${s// OR / }"
    [[ -n "${s// /}" ]] || return 1
    read -ra toks <<<"$s"
    for tok in "${toks[@]}"; do
        [[ "$list" == *" $tok "* ]] || return 1
    done
    return 0
}

# lcc_evaluate : read records on stdin (project license in LCC_PROJECT_LICENSE), write them with two more
# fields: status (ok, forbidden, review) and reason.
lcc_evaluate() {
    local name ver path lic src note status reason rc r w i
    local -a projs=() pat_str=() patterns=()
    # "A AND B" as project license (several licenses): a dependency must be allowed by each of them.
    mapfile -t projs < <(printf '%s\n' "${LCC_PROJECT_LICENSE// AND /$'\n'}")
    for i in "${!projs[@]}"; do
        [[ -n "${LCC_MATRIX[${projs[i]}]+x}" ]] ||
            lcc_die "no matrix row for the project license '${projs[i]}'; add a 'matrix ${projs[i]} ...' line to .license-compliance"
        pat_str[i]="$(lcc_patterns_for "${projs[i]}" | tr '\n' ' ')"
    done

    local -a LCC_KNOWN_PATTERNS=()
    for w in ${LCC_GROUPS[@]+"${LCC_GROUPS[@]}"} ${LCC_MATRIX[@]+"${LCC_MATRIX[@]}"}; do
        [[ "$w" == @* || "$w" == *[\<\>]* ]] || LCC_KNOWN_PATTERNS+=("$w")
    done

    while IFS=$LCC_FS read -r name ver path lic src note; do
        [[ -n "$name$path" ]] || continue
        if lcc__allow_exception "$name" "$lic"; then
            status="ok" reason="allowed by config"
        elif [[ -z "${lic// /}" || "$lic" == "UNKNOWN" ]]; then
            status="review" reason="${note:-license not found or not recognized}"
        else
            rc=0
            for i in "${!projs[@]}"; do
                read -ra patterns <<<"${pat_str[i]}"
                r=0
                lcc_is_allowed "$lic" "${patterns[@]}" || r=$?
                # not allowed (1) beats undecidable (2) beats allowed (0)
                if ((r == 1)); then rc=1; elif ((r == 2 && rc == 0)); then rc=2; fi
            done
            case "$rc" in
                0)
                    # several license files are informational: every one of their licenses is allowed
                    if [[ -n "$note" && "$note" != "multiple license files" ]]; then
                        status="review" reason="$note"
                    else
                        status="ok" reason="allowed for ${LCC_PROJECT_LICENSE}${note:+ ($note)}"
                    fi
                    ;;
                2) status="review" reason="license expression too complex to evaluate: ${lic}" ;;
                *)
                    if lcc__all_known "$lic"; then
                        status="forbidden" reason="${lic} is not allowed for a ${LCC_PROJECT_LICENSE} project"
                    else
                        status="review" reason="unrecognized license: ${lic}"
                    fi
                    ;;
            esac
        fi
        lcc__clean_to reason "$reason"
        printf '%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s\n' \
            "$name" "$LCC_FS" "$ver" "$LCC_FS" "$path" "$LCC_FS" "$lic" "$LCC_FS" "$src" "$LCC_FS" "$note" "$LCC_FS" \
            "$status" "$LCC_FS" "$reason"
    done
}

# lcc_report_table : print evaluated records (stdin) as a table, the reasons of the entries that are not ok,
# and a summary. Colors only on a terminal (and when NO_COLOR is unset).
lcc_report_table() {
    local name ver path lic src note status reason sym
    local total=0 n_ok=0 n_forbidden=0 n_review=0
    local green="" red="" yellow="" reset=""
    local -a details=()
    if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
        green=$'\e[32m' red=$'\e[31m' yellow=$'\e[33m' reset=$'\e[0m'
    fi

    printf '%-44s  %-12s  %-44s  %-5s  %s\n' Name Version License Check Source
    while IFS=$LCC_FS read -r name ver path lic src note status reason; do
        [[ -n "$name$path" ]] || continue
        total=$((total + 1))
        case "$status" in
            ok) sym="${green}✓${reset}" n_ok=$((n_ok + 1)) ;;
            forbidden)
                sym="${red}✗${reset}" n_forbidden=$((n_forbidden + 1))
                details+=("  forbidden  ${name}: ${reason}")
                ;;
            *)
                sym="${yellow}?${reset}" n_review=$((n_review + 1))
                details+=("  review     ${name}: ${reason}")
                ;;
        esac
        # names are paths: when too long, keep the distinguishing tail
        if ((${#name} > 44)); then name="...${name: -41}"; fi
        printf '%-44.44s  %-12.12s  %-44.44s  %s    %s\n' "$name" "$ver" "$lic" "$sym" "$src"
    done

    if ((${#details[@]})); then
        printf '\n'
        printf '%s\n' "${details[@]}"
    fi
    printf '\n%d dependencies: %d ok, %d forbidden, %d review\n' "$total" "$n_ok" "$n_forbidden" "$n_review"
}

# lcc_report_json : print evaluated records (stdin) as a JSON array.
lcc_report_json() {
    jq -R -s --arg fs "$LCC_FS" '
        split("\n") | map(select(length > 0) | split($fs)
            | {name: .[0], version: .[1], path: .[2], license: .[3], source: .[4], note: .[5], status: .[6], reason: .[7]})'
}

# lcc_exit_code : read evaluated records (stdin); return 1 on a forbidden entry (or a review one with --strict).
lcc_exit_code() {
    local name ver path lic src note status reason rc=0
    while IFS=$LCC_FS read -r name ver path lic src note status reason; do
        if [[ "$status" == "forbidden" ]]; then
            rc=1
        elif [[ "$status" == "review" && "${LCC_STRICT:-0}" -eq 1 ]]; then
            rc=1
        fi
    done
    return "$rc"
}

main() {
    local records evaluated
    lcc_require_env
    lcc_parse_args "$@"
    [[ -d "$LCC_PATH" ]] || lcc_die "not a directory: $LCC_PATH"
    LCC_PATH="$(cd -- "$LCC_PATH" && pwd -P)"

    lcc_load_defaults
    if [[ -n "$LCC_CONFIG" ]]; then
        lcc_load_config "$LCC_CONFIG"
    elif [[ -r "$LCC_PATH/.license-compliance" ]]; then
        lcc_load_config "$LCC_PATH/.license-compliance"
    fi
    LCC_PROJECT_LICENSE="$(lcc_resolve_project_license "$LCC_PATH")" || exit 2

    records="$(lcc_discover "$LCC_PATH")"
    if [[ -z "$records" ]]; then
        if ((LCC_JSON)); then printf '[]\n'; else printf 'no dependencies found\n'; fi
        return 0
    fi

    evaluated="$(lcc_evaluate <<<"$records")" || exit 2
    if ((LCC_JSON)); then
        lcc_report_json <<<"$evaluated"
    else
        printf 'Project license: %s\n\n' "$LCC_PROJECT_LICENSE"
        lcc_report_table <<<"$evaluated"
    fi
    lcc_exit_code <<<"$evaluated"
}

if [[ -z "${LCC_SOURCE_ONLY:-}" ]]; then
    set -euo pipefail
    main "$@"
fi
