{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "getlaraplate/laraplate",
  "vendor": "getlaraplate",
  "type": "project",
  "description": "Modular Laravel platform with a Filament backoffice: install only the modules you need (CMS, CRM, ERP, MES, Shop, AI).",
  "version": "v1.14.1",
  "keywords": [
    "laravel",
    "laraplate",
    "framework"
  ],
  "authors": [
    {
      "name": "Swolley",
      "email": "myentity@inwind.it"
    }
  ],
  "license": "AGPL-3.0-or-later",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/swolley/license-compliance-checker.git",
      "no-api": true
    }
  ],
  "require": {
    "php": ">=8.5",
    "coolsam/modules": "^5.1",
    "filament/filament": "^5.6.3",
    "joshbrw/laravel-module-installer": "^2.0.1",
    "laravel/framework": "^12.59",
    "laravel/sanctum": "^4.3.2",
    "laravel/tinker": "^2.11.1",
    "nwidart/laravel-modules": "^12.0.5",
    "php-mqtt/client": "^2.3",
    "symfony/http-client": "^7.4.9"
  },
  "require-dev": {
    "swolley/license-compliance-checker": "dev-master",
    "barryvdh/laravel-ide-helper": "^3.7",
    "dg/bypass-finals": "^1.11",
    "driftingly/rector-laravel": "^2.6",
    "fakerphp/faker": "^1.24.1",
    "larastan/larastan": "^3.12",
    "laravel/boost": "^2.9",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.32",
    "laravel/sail": "^1.59",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.9.4",
    "peckphp/peck": "^0.1.3",
    "pestphp/pest": "^4.7",
    "pestphp/pest-plugin-laravel": "^4.1",
    "pestphp/pest-plugin-stressless": "^4.0",
    "pestphp/pest-plugin-type-coverage": "^4.0",
    "rector/rector": "^2.6"
  },
  "conflict": {
    "filament/widgets": ">=5.11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "php artisan ide-helper:models --nowrite --reset"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "lint": [
      "rector",
      "pint --parallel",
      "php artisan ide-helper:generate",
      "php artisan ide-helper:models --nowrite --reset",
      "php artisan ide-helper:meta"
    ],
    "check": "vendor/bin/phpstan analyse --memory-limit=4G -v",
    "check:debt": "@php scripts/phpstan-debt.php",
    "fix": "vendor/bin/phpstan analyse --memory-limit=4G -v --fix",
    "refactor": "rector",
    "test:type-coverage": [
      "Composer\\Config::disableProcessTimeout",
      "php -d memory_limit=4G vendor/bin/pest --type-coverage --min=100"
    ],
    "test:typos": "peck",
    "test:lint": [
      "pint --parallel --test",
      "rector --dry-run"
    ],
    "test:coverage": "pest --parallel --coverage --exactly=100",
    "test:unit": "php artisan test --compact --testsuite=Unit",
    "test:integration": "php artisan test --compact --testsuite=Integration",
    "test:feature": "php artisan test --compact --testsuite=Feature",
    "test:modules": [
      "@test:unit",
      "@test:integration",
      "@test:feature"
    ],
    "test:pest": "vendor/bin/pest --compact",
    "test:pest:parallel": "vendor/bin/pest --parallel --compact",
    "test:types": "phpstan",
    "test:refactor": "rector",
    "test:licenses": "@php vendor/bin/check-licenses",
    "test": [
      "@test:type-coverage",
      "@test:coverage",
      "@test:modules",
      "@test:lint",
      "@test:types",
      "@test:refactor",
      "@test:licenses"
    ],
    "update:requirements": [
      "composer bump",
      "npx npm-check-updates -u"
    ],
    "plan-status": "@php scripts/plan-status.php",
    "plan-status:test": "bash scripts/tests/plan-status-test.sh",
    "update-all": "./scripts/update-composer.sh"
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "barryvdh/laravel-ide-helper"
      ]
    },
    "merge-plugin": {
      "include": [
        "composer.*.json",
        "Modules/*/composer.json"
      ],
      "recurse": true,
      "replace": false,
      "ignore-duplicates": true,
      "merge-dev": true,
      "merge-extra": true,
      "merge-extra-deep": true,
      "merge-replace": true,
      "merge-scripts": true,
      "merge-config": [
        "platform"
      ]
    },
    "installer-paths": {
      "Modules/{$name}/": [
        "type:module"
      ]
    }
  },
  "config": {
    "process-timeout": 7200,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "joshbrw/laravel-module-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "wikimedia/composer-merge-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
